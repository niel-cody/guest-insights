# The access gate. Copy to .env.local for local development, and set the same
# two variables in Vercel for the deployed site.
#
# Nothing is served until BOTH are present and valid — the proxy returns a 503
# naming the problem rather than serving the report. That is deliberate: the
# realistic failure is the code shipping while the environment variable does
# not, and a gate that fails open looks healthy while two customers' data sits
# in public.
#
# ─────────────────────────────────────────────────────────────────────────────
# SITE_ACCESS — one grant per audience, as a single line of JSON.
#
#   label     shown in the header as "Signed in as …", so a reviewer can see
#             whose report they are in
#   password  minimum 12 characters, enforced at boot
#   orgs      the org slugs this password opens; ["*"] opens every one
#
# A password opens exactly the organisations listed and nothing else. The check
# runs in src/proxy.ts against the request path, before any page renders — the
# organisation switcher hiding a menu item is convenience, not the control.
#
# Two grants may not share a password: that would make entitlement depend on the
# order of this list. The gate refuses to start rather than resolve it.
SITE_ACCESS=[{"label":"Coffee Guru","password":"CHANGE-ME-at-least-12","orgs":["coffee-guru"]},{"label":"Meat Flour Wine","password":"CHANGE-ME-at-least-12","orgs":["meat-flour-wine"]},{"label":"Oolio","password":"CHANGE-ME-at-least-12","orgs":["*"]}]

# ─────────────────────────────────────────────────────────────────────────────
# SESSION_SECRET — the HMAC key that signs session cookies. Minimum 32 chars.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it signs everybody out. So does changing a password, or changing
# which organisations a grant opens — the signed session carries a fingerprint
# of the whole grant, so narrowing a customer's access takes effect immediately
# rather than at the next login.
SESSION_SECRET=CHANGE-ME-at-least-32-characters-long
